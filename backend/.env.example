APP_NAME=Portal Automacoes API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_automacoes
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
FRONTEND_URL=http://localhost:3000
# "*" liberado para uso em rede local (acesso via IP da maquina, nao so localhost).
# Restrinja para origens especificas antes de expor isto na internet.
ALLOWED_ORIGINS=*
FIRST_SUPERUSER_EMAIL=admin@portal.local
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_NAME=Administrator
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Package/artifact storage (automation catalog) ---
# "local" writes to LOCAL_STORAGE_PATH inside the backend container (fine for a
# single instance / dev). Switch to "s3" to use the bundled MinIO service below
# (see docker-compose.yml) or a real S3 bucket in production.
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=/data/packages
S3_ENDPOINT_URL=http://minio:9000
# Address baked into presigned download URLs for the Automation Agent, which
# runs on a different machine and can't resolve Docker service names like
# "minio". Set this to the same host/IP as BACKEND_PUBLIC_URL with MinIO's
# published port (e.g. http://192.168.1.35:9000). Leave empty to fall back to
# S3_ENDPOINT_URL (only correct when everything runs on one machine).
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
PACKAGES_BUCKET_NAME=automation-packages
MAX_UPLOAD_SIZE_MB=200
IMPORT_STAGING_TTL_SECONDS=1800

# --- GitHub App integration (catalog import from biason-automations) ---
# Create the App first — see docs/github-app-setup.md for exact steps. Leave
# these empty to keep the GitHub import flow disabled (manual ZIP upload still
# works without any of this).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the full PEM private key on one line with \n for newlines, e.g.:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
