{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal-automacoes.local/contracts/manifests/automation-manifest.schema.json",
  "title": "Automation manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "runtime", "entrypoint"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "runtime": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "module": { "type": "string" },
        "callable": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "../capabilities/capability-requirement.schema.json" }
            ]
          }
        }
      }
    }
  }
}
