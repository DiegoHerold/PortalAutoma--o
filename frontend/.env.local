# Desabilita telemetria do Next.js
NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_API_URL removido de proposito: o frontend descobre o host da
# API sozinho em tempo de execucao (mesmo IP/hostname usado para abrir o
# site, porta 8000) — ver src/lib/constants.ts. Definir essa variavel aqui
