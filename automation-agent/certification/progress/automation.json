{
  "schema_version": 1,
  "id": "certification.progress",
  "name": "Certification Progress",
  "version": "1.0.0",
  "description": "Emits a 0/20/40/60/80/100 progress sequence at a configurable interval, used to check whether progress reaches Portal live or only through the final result.",
  "runtime": {
    "id": "python-core",
    "version": "3.13"
  },
  "entrypoint": {
    "type": "python_function",
    "module": "automation.main",
    "callable": "run"
  },
  "capabilities": {
    "required": ["windows", "agent.background_execution"]
  },
  "resources": {
    "pool": "background",
    "slots": 1
  },
  "timeout": {
    "execution_seconds": 60,
    "graceful_shutdown_seconds": 10
  }
}
