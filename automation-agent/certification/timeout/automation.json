{
  "schema_version": 1,
  "id": "certification.timeout",
  "name": "Certification Timeout",
  "version": "1.0.0",
  "description": "Deliberately runs longer than its manifest timeout to prove ExecutionHost's timeout/kill path and the resulting TIMED_OUT terminal state reach Portal.",
  "runtime": {
    "id": "python-core",
    "version": "3.13"
  },
  "entrypoint": {
    "type": "python_function",
    "module": "automation.main",
    "callable": "run"
  },
  "capabilities": {
    "required": ["windows", "agent.background_execution"]
  },
  "resources": {
    "pool": "background",
    "slots": 1
  },
  "timeout": {
    "execution_seconds": 8,
    "graceful_shutdown_seconds": 5
  }
}
