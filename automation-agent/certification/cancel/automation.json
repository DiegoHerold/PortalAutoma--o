{
  "schema_version": 1,
  "id": "certification.cancel",
  "name": "Certification Cancel",
  "version": "1.0.0",
  "description": "Long-running background package used to prove Portal-initiated cancellation reaches Agent.Service and terminates the real ExecutionHost tree.",
  "runtime": {
    "id": "python-core",
    "version": "3.13"
  },
  "entrypoint": {
    "type": "python_function",
    "module": "automation.main",
    "callable": "run"
  },
  "capabilities": {
    "required": ["windows", "agent.background_execution"]
  },
  "resources": {
    "pool": "background",
    "slots": 1
  },
  "timeout": {
    "execution_seconds": 90,
    "graceful_shutdown_seconds": 10
  }
}
