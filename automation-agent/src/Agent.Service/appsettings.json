{
  "Agent": {
    "Name": null,
    "Profile": "workstation",
    "Version": "0.3.0"
  },
  "Portal": {
    "Enabled": false,
    "ApiBaseUrl": "",
    "WebSocketUrl": "",
    "RegistrationToken": null,
    "ConnectionTimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 15,
    "ReconnectInitialSeconds": 2,
    "ReconnectMaximumSeconds": 120,
    "RegistrationTimeoutSeconds": 60,
    "CredentialRotationThresholdDays": 7,
    "RequireSecureTransport": true
  },
  "Storage": {
    "MinimumFreeDiskMb": 2048
  },
  "Monitoring": {
    "SampleIntervalSeconds": 5,
    "HistoryRetentionMinutes": 60
  },
  "MachineProfiler": {
    "RefreshIntervalMinutes": 60
  },
  "Database": {
    "BusyTimeoutMs": 5000,
    "JournalMode": "WAL"
  },
  "AgentLogging": {
    "MaxFileSizeMb": 50,
    "RetainedFileCountLimit": 5
  },
  "Execution": {
    "DefaultTimeoutSeconds": 3600,
    "GracefulShutdownSeconds": 30,
    "MaxConcurrentExecutions": 5,
    "ReservationTimeoutSeconds": 300,
    "RequirePackageSignature": false
  },
  "Capacity": {
    "BackgroundPoolSize": 3,
    "BrowserPoolSize": 1,
    "InteractivePoolSize": 1,
    "SnapshotTtlSeconds": 60
  },
  "Download": {
    "MaxRetries": 3,
    "InitialRetryDelaySeconds": 2,
    "DownloadTimeoutSeconds": 600,
    "BufferSizeBytes": 81920,
    "MaxCompressionRatio": 100,
    "MaxExtractedSizeMb": 2048
  },
  "Messaging": {
    "OutboxBatchSize": 500,
    "PollIntervalSeconds": 1,
    "AcknowledgementTimeoutSeconds": 30,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 5
  },
  "SessionRunner": {
    "PipeName": "BiasonAutomationAgent.Session.v1",
    "HeartbeatIntervalSeconds": 5,
    "DisconnectTimeoutSeconds": 20,
    "ReconnectInitialDelaySeconds": 1,
    "ReconnectMaximumDelaySeconds": 30,
    "AllowRdpSessions": true,
    "ExpectRunnerForActiveSessions": false,
    "ExpectedExecutablePath": null,
    "ExecutionHostPath": null
  },
  "InteractiveSessions": {
    "DefaultSelectionPolicy": "active_unlocked"
  },
  "InteractivePool": {
    "GlobalSlots": 1,
    "PerSessionSlots": 1,
    "LockLeaseSeconds": 300
  },
  "InteractiveExecution": {
    "SessionLockGraceSeconds": 60,
    "OnSessionLocked": "wait_then_cancel",
    "OnRdpDisconnected": "wait_then_cancel",
    "ExcelExistingProcessPolicy": "new_instance",
    "DominioExistingProcessPolicy": "reject"
  },
  "Screenshots": {
    "Enabled": true,
    "OnFailure": true,
    "OnTimeout": true,
    "OnCancel": true,
    "MaximumPerExecution": 10,
    "MaximumSizeMb": 10
  },
  "LocalProtocol": {
    "Version": "1.0",
    "MaximumMessageBytes": 1048576,
    "ChallengeExpirationSeconds": 30,
    "SessionTokenExpirationMinutes": 60,
    "ExecutionTokenExpirationMinutes": 15
  },
  "Security": {
    "RequireHashVerification": true,
    "RequirePackageSignature": false,
    "BlockPathTraversal": true,
    "AllowedExecutableExtensions": [ ".py", ".ps1", ".exe" ]
  },
  "Development": {
    "DataDirectory": null,
    "ConsoleLogging": true
  }
}
