{
  "Agent": {
    "Name": null,
    "Profile": "workstation",
    "Version": "0.2.0"
  },
  "Storage": {
    "MinimumFreeDiskMb": 2048
  },
  "Monitoring": {
    "SampleIntervalSeconds": 5,
    "HistoryRetentionMinutes": 60
  },
  "MachineProfiler": {
    "RefreshIntervalMinutes": 60
  },
  "Database": {
    "BusyTimeoutMs": 5000,
    "JournalMode": "WAL"
  },
  "AgentLogging": {
    "MaxFileSizeMb": 50,
    "RetainedFileCountLimit": 5
  },
  "Execution": {
    "DefaultTimeoutSeconds": 3600,
    "GracefulShutdownSeconds": 30,
    "MaxConcurrentExecutions": 5,
    "ReservationTimeoutSeconds": 300,
    "RequirePackageSignature": false
  },
  "Capacity": {
    "BackgroundPoolSize": 3,
    "BrowserPoolSize": 1,
    "InteractivePoolSize": 1,
    "SnapshotTtlSeconds": 60
  },
  "Download": {
    "MaxRetries": 3,
    "InitialRetryDelaySeconds": 2,
    "DownloadTimeoutSeconds": 600,
    "BufferSizeBytes": 81920,
    "MaxCompressionRatio": 100,
    "MaxExtractedSizeMb": 2048
  },
  "Security": {
    "RequireHashVerification": true,
    "RequirePackageSignature": false,
    "BlockPathTraversal": true,
    "AllowedExecutableExtensions": [ ".py", ".ps1", ".exe" ]
  },
  "Development": {
    "DataDirectory": null,
    "ConsoleLogging": true
  }
}
