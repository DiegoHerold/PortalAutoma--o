{
  "schema_version": 1,
  "id": "example.background_python",
  "name": "Background Python Example",
  "version": "1.0.0",
  "description": "Processes a list of items, writes logs, reports progress, generates result and artifact.",
  "runtime": {
    "id": "python-core",
    "version": "3.13"
  },
  "entrypoint": {
    "type": "python_function",
    "module": "automation.main",
    "callable": "run"
  },
  "capabilities": {
    "required": ["windows", "agent.background_execution"]
  },
  "resources": {
    "pool": "background",
    "slots": 1
  },
  "timeout": {
    "execution_seconds": 300,
    "graceful_shutdown_seconds": 10
  }
}
